# Copiar este archivo como .env y completar los valores.

# Conexión a PostgreSQL: postgresql://usuario:contraseña@host:puerto/base
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/foodstore_db
# Alternativa sin PostgreSQL (solo desarrollo): crea el archivo foodstore.db en backend/
# DATABASE_URL=sqlite:///./foodstore.db

# Clave para firmar el JWT: al menos 32 caracteres aleatorios.
# Para generarla: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
